{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "../../.oxlintrc.json"
  ],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "garmin-mcp-store",
              "garmin-mcp-store/*",
              "garmin-mcp-domain",
              "garmin-mcp-domain/*",
              "garmin-mcp-server",
              "garmin-mcp-server/*",
              "garmin-mcp-cli",
              "garmin-mcp-cli/*"
            ],
            "message": "Layer violation: garmin-mcp-client may only import garmin-mcp-auth, garmin-mcp-config."
          }
        ]
      }
    ]
  }
}
