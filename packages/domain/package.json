{
  "name": "garmin-mcp-domain",
  "version": "0.3.0",
  "description": "Training metrics, trends, period summaries and the structured workout builder behind Garmin MCP, the unofficial MCP server for Garmin Connect. Not affiliated with Garmin.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garmin-mcp",
    "garmin-mcp-server",
    "garmin-connect-mcp",
    "garmin-ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-assistant",
    "garmin-workout",
    "structured-workouts",
    "training-load",
    "running",
    "cycling",
    "triathlon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "packages/domain"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-store": "workspace:*",
    "garmin-mcp-client": "workspace:*",
    "garmin-mcp-auth": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "zod": "^4.6.5"
  }
}
