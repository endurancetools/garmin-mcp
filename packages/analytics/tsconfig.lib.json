{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/test-utils/**"
  ],
  "references": [
    {
      "path": "../domain/tsconfig.lib.json"
    },
    {
      "path": "../store/tsconfig.lib.json"
    },
    {
      "path": "../config/tsconfig.lib.json"
    }
  ]
}
