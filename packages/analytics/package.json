{
  "name": "garmin-mcp-analytics",
  "version": "0.2.0",
  "description": "Training analytics behind Garmin MCP: TSS from power, pace, heart rate or RPE, CTL/ATL/TSB, ACWR, intensity distribution, efficiency, decoupling and HRV-based readiness, with cited methods. Unofficial, not affiliated with Garmin.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garmin-mcp",
    "garmin-mcp-server",
    "garmin-connect-mcp",
    "garmin-ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-assistant",
    "training-load",
    "ctl-atl-tsb",
    "fitness-fatigue-form",
    "hrv",
    "training-readiness",
    "tss",
    "hrtss",
    "rtss",
    "acwr",
    "acute-chronic-workload-ratio",
    "aerobic-decoupling",
    "polarized-training",
    "intensity-distribution",
    "sports-science"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "packages/analytics"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-domain": "workspace:*",
    "garmin-mcp-store": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "zod": "^4.6.5"
  }
}
