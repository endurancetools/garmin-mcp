{
  "name": "garmin-mcp-store",
  "version": "0.4.1",
  "description": "Local SQLite cache and synchronisation of Garmin Connect data for Garmin MCP, the unofficial MCP server for Garmin Connect. Not affiliated with Garmin.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garmin-mcp",
    "garmin-mcp-server",
    "garmin-connect-mcp",
    "garmin-ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-assistant",
    "sqlite",
    "local-cache"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "packages/store"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-client": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}
