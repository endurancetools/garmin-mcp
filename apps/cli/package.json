{
  "name": "garmin-mcp-cli",
  "version": "0.1.1",
  "description": "CLI for Garmin MCP: login, sync, queries and diagnostics",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-server": "workspace:*",
    "garmin-mcp-domain": "workspace:*",
    "garmin-mcp-store": "workspace:*",
    "garmin-mcp-client": "workspace:*",
    "garmin-mcp-auth": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "commander": "^15.0.0"
  },
  "bin": {
    "garmin": "./dist/main.js",
    "garmin-mcp-cli": "./dist/main.js"
  }
}
