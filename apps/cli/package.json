{
  "name": "garmin-mcp-cli",
  "version": "0.3.1",
  "description": "Command line for Garmin MCP, the unofficial MCP server for Garmin Connect: sign in, sync to a local cache, and training load and morning readiness in the terminal. Not affiliated with Garmin.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garmin-mcp",
    "garmin-mcp-server",
    "garmin-connect-mcp",
    "garmin-ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-assistant",
    "garmin-cli",
    "training-load",
    "ctl-atl-tsb",
    "fitness-fatigue-form",
    "hrv",
    "training-readiness",
    "running",
    "cycling",
    "triathlon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-server": "workspace:*",
    "garmin-mcp-analytics": "workspace:*",
    "garmin-mcp-domain": "workspace:*",
    "garmin-mcp-store": "workspace:*",
    "garmin-mcp-client": "workspace:*",
    "garmin-mcp-auth": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "commander": "^15.0.0"
  },
  "bin": {
    "garmin": "./dist/main.js",
    "garmin-mcp-cli": "./dist/main.js"
  }
}
