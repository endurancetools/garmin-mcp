{
  "name": "garmin-mcp-server",
  "mcpName": "io.github.endurancetools/garmin-mcp",
  "version": "0.3.0",
  "description": "Unofficial, open-source MCP server for Garmin Connect. Ask Claude or any MCP client about your training: load, form and morning readiness computed locally with cited sports-science methods, and workouts sent to your watch. Not affiliated with Garmin.",
  "keywords": [
    "garmin",
    "garmin-connect",
    "garmin-mcp",
    "garmin-mcp-server",
    "garmin-connect-mcp",
    "garmin-ai",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-desktop",
    "ai-assistant",
    "training-load",
    "ctl-atl-tsb",
    "fitness-fatigue-form",
    "hrv",
    "training-readiness",
    "acwr",
    "garmin-workout",
    "structured-workouts",
    "running",
    "cycling",
    "triathlon"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endurancetools/garmin-mcp.git",
    "directory": "apps/mcp-server"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "garmin-mcp-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo",
    "!dist/test-utils"
  ],
  "dependencies": {
    "garmin-mcp-analytics": "workspace:*",
    "garmin-mcp-domain": "workspace:*",
    "garmin-mcp-store": "workspace:*",
    "garmin-mcp-client": "workspace:*",
    "garmin-mcp-auth": "workspace:*",
    "garmin-mcp-config": "workspace:*",
    "zod": "^4.6.5",
    "@modelcontextprotocol/server": "^2.3.1",
    "@modelcontextprotocol/node": "^2.1.1"
  },
  "bin": {
    "garmin-mcp-server": "./dist/main.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1"
  }
}
